<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same surface colours as the injected UI: black chrome, green accent. -->
    <style name="Theme.SpotiDuck" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/sd_background</item>
        <item name="android:colorBackground">@color/sd_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- API 27+; ignored on older releases. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
