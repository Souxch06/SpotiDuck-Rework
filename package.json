{
  "name": "spotiduck-ui",
  "version": "2.5.1",
  "private": true,
  "description": "Mobile UI layer (Spotify-app-like shell) injected into the SpotiDuck WebView",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "smoke": "node tools/smoke.mjs",
    "sync:android": "node tools/sync-android.mjs",
    "android": "node tools/build.mjs && node tools/sync-android.mjs",
    "demo": "node tools/serve.mjs",
    "shots": "node tools/screenshots.mjs"
  },
  "keywords": [
    "spotiduck",
    "spotify",
    "webview",
    "userscript",
    "ui"
  ],
  "license": "GPL-3.0",
  "devDependencies": {
    "jsdom": "^25.0.1"
  }
}
